{
  "name": "dota-draft-recommender",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "expo export --platform web",
    "deploy": "expo export --platform web && wrangler pages deploy dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:dataset": "tsx scripts/build-dataset.ts",
    "build:dataset:sample": "tsx scripts/build-sample-dataset.ts",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.20",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^22.10.2",
    "@types/react": "~18.3.12",
    "tsx": "^4.19.2",
    "typescript": "~5.3.3",
    "vitest": "^2.1.8"
  },
  "private": true
}
