# Online captains arena (optional). Without these, the app works fully except
# the online arena; the local pass-and-play arena needs nothing.
#
# Create a free project at supabase.com, run db/schema.sql in its SQL editor,
# then copy the values from Settings -> API here into a `.env` file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
